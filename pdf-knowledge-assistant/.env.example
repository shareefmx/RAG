# ==============================================================================
# PDF Knowledge Assistant - Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "gemini" or "openrouter"
LLM_PROVIDER=gemini

# Primary Provider: Google Gemini
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative Provider: OpenRouter
# Obtain key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection
# For Gemini: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
# For OpenRouter: meta-llama/llama-3-8b-instruct:free, mistralai/mistral-7b-instruct
LLM_MODEL=gemini-2.5-flash

# Embeddings Configuration
# Sentence-Transformers models from Hugging Face:
# - sentence-transformers/all-MiniLM-L6-v2 (384 dims, fast, lightweight)
# - sentence-transformers/all-mpnet-base-v2 (768 dims, higher accuracy)
# - BAAI/bge-small-en-v1.5 (384 dims, competitive performance)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database Selection: "faiss" or "chroma"
VECTOR_STORE=faiss

# Text Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval Settings
TOP_K=5
CANDIDATE_TOP_K=15
SIMILARITY_THRESHOLD=0.15

# Advanced Retrieval: Cross-Encoder Reranker
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Query Rewriting (using LLM to resolve conversational follow-ups)
ENABLE_QUERY_REWRITING=true

# Storage Directories
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTORSTORE_DIR=data/vectorstore

# Application Environment & Logging
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

